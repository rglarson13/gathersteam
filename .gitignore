# Secrets: Steam API key and Steam ID. Also catches .env.bak, .env.local, etc.
.env
.env.*
!.env.example

# Launcher databases/caches by TYPE, not just by folder: GOG Galaxy's database
# contains clientSecret values, so it must never be committed even if copied
# somewhere other than input/.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*catcache*.bin

# Sources, state and caches: your library export, triage decisions, API caches.
data/

# Launcher databases copied from Epic / GOG Galaxy installs. Large (GOG's is
# ~110MB, over GitHub's 100MB file limit), and they hold account-linked local
# state. Copy your own in; never commit them.
input/

# Everything derived from data/. Safe to delete; rebuilt by the pipeline.
output/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
