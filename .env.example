# Copy to .env and fill in. Never commit .env.
# Free API key: https://steamcommunity.com/dev/apikey  (any domain works,
# "localhost" is fine - the field is not validated)
STEAM_API_KEY=your_key_here

# Your Steam64 ID, a vanity name, or a full profile URL.
# STEAMID64 / CUSTOMURL are also accepted, so a paste from a lookup site works.
STEAM_ID=76561198000000000
